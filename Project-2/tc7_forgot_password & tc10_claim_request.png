# save as reports/generate_placeholders.py and run: python reports/generate_placeholders.py
from PIL import Image, ImageDraw, ImageFont
import os

os.makedirs("reports/screenshots", exist_ok=True)

def make_placeholder(path, text):
    img = Image.new("RGB", (900, 500), color=(245,245,250))
    d = ImageDraw.Draw(img)
    try:
        f = ImageFont.truetype("arial.ttf", 28)
    except:
        f = ImageFont.load_default()
    w, h = d.textsize(text, font=f)
    d.text(((900-w)/2, (500-h)/2), text, fill=(40,40,40), font=f)
    img.save(path)

make_placeholder("reports/screenshots/tc7_forgot_password.png", "TC07 - Forgot Password Placeholder")
make_placeholder("reports/screenshots/tc10_claim_request.png", "TC10 - Claim Request Placeholder")
print("Placeholder screenshots created in reports/screenshots/")
